{
  "files": ["./types/target_lib.d.ts"],
  "compilerOptions": {
    "target": "ES2024",
    "module": "es6",
    "lib": [
      "ES2024",
      "ESNext.Collection",
      "ESNext.Iterator",
      "ESNext.Promise",
      "ESNext.Float16",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "node",
    "types": [
      "node"
    ],
    "paths": {
      "@odoo/owl-core": ["./packages/owl-core/src/index"],
      "@odoo/owl-compiler": ["./packages/owl-compiler/src/index"],
      "@odoo/owl-runtime": ["./packages/owl-runtime/src/index"]
    },
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": true
  }
}
