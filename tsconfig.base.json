{
  /**
   ** Base TypeScript configuration shared across all packages.
   ** Commented-out options have their default values.
   **/
  "compilerOptions": {
                                                                // Main options
    "target": "ES2022",
    "module": "es6",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
                                                                // Strict typechecking options
    "strict": true,
                                                                // Additional checks
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
                                                                // Module resolution options
    "moduleResolution": "node",
    "types": [
      "node"
    ],
    // sibling packages are typed from their sources: their dist/types exist
    // only after build:types
    "paths": {
      "@odoo/owl-core": ["./packages/owl-core/src/index"],
      "@odoo/owl-compiler": ["./packages/owl-compiler/src/index"],
      "@odoo/owl-runtime": ["./packages/owl-runtime/src/index"]
    },
    "esModuleInterop": true,
    "resolveJsonModule": true,
                                                                // Emit options
    "declaration": true
  }
}
