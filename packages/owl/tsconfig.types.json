{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // dts-bundle-generator uses its entry files rather than tsconfig.files;
    // target library declarations must be in compilerOptions as well.
    "types": ["node", "../../types/target_lib"],
    "baseUrl": ".",
    "paths": {
      "@odoo/owl-core": ["../owl-core/src/index.ts"],
      "@odoo/owl-compiler": ["../owl-compiler/src/index.ts"],
      "@odoo/owl-runtime": ["../owl-runtime/src/index.ts"]
    }
  }
}
