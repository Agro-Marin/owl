// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`t-set > slot setted value (with t-set) not accessible with t-out 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { safeOutput, markRaw, createComponent } = helpers;
  const comp1 = createComponent(app, \`Childcomp\`, true, true, false, []);
  
  let block1 = createBlock(\`<div><p><block-child-0/></p><block-child-1/><p><block-child-2/></p></div>\`);
  
  function slot1(ctx, node, key = "") {
    ctx = Object.create(ctx);
    ctx["iter"] = 'inCall';
  return text('');
  }
  
  return function template(ctx, node, key = "") {
    ctx = Object.create(ctx);
    ctx["iter"] = 'source';
    const b2 = safeOutput(ctx['iter'], node, key, "\\u00021");
    const b3 = comp1({slots: markRaw({"default": {__render: slot1, __ctx: ctx, __owner: this}})}, key + \`\\u00022\`, node, this, null);
    const b4 = safeOutput(ctx['iter'], node, key, "\\u00023");
    return block1([], [b2, b3, b4]);
  }
}"
`;

exports[`t-set > slot setted value (with t-set) not accessible with t-out 2`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { safeOutput } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/><block-child-1/></div>\`);
  
  return function template(ctx, node, key = "") {
    ctx = Object.create(ctx);
    const b2 = safeOutput(ctx['iter'], node, key, "\\u00021");
    ctx["iter"] = 'called';
    const b3 = safeOutput(ctx['iter'], node, key, "\\u00022");
    return block1([], [b2, b3]);
  }
}"
`;

exports[`t-set > slots with a t-set with a component in body 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { LazyValue, createComponent, safeOutput, markRaw } = helpers;
  const comp1 = createComponent(app, \`C\`, true, false, false, []);
  const comp2 = createComponent(app, \`Child\`, true, true, false, []);
  
  function slot1(ctx, node, key = "") {
    ctx = Object.create(ctx);
    ctx["v"] = new LazyValue(value1, ctx, this, node, key + \`\\u00022\`);
    const b3 = text(\` in slot \`);
    const b4 = safeOutput(ctx['v'], node, key, "\\u00023");
    return multi([b3, b4]);
  }
  
  function value1(ctx, node, key = "") {
    return comp1({}, key + \`\\u00021\`, node, this, null);
  }
  
  return function template(ctx, node, key = "") {
    return comp2({slots: markRaw({"default": {__render: slot1, __ctx: ctx, __owner: this}})}, key + \`\\u00024\`, node, this, null);
  }
}"
`;

exports[`t-set > slots with a t-set with a component in body 2`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { callSlot } = helpers;
  
  return function template(ctx, node, key = "") {
    const b2 = text(\`Child \`);
    const b3 = callSlot(ctx, node, key + \`\\u00021\`, "default", false, null);
    return multi([b2, b3]);
  }
}"
`;

