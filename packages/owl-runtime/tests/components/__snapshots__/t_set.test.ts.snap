exports[`t-set > t-set body with a component, output in nested loops 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { prepareList, LazyValue, createComponent, safeOutput, withKey, keyOf } = helpers;
  const comp1 = createComponent(app, \`Cell\`, true, false, false, []);
  
  let block1 = createBlock(\`<div><block-child-0/></div>\`);
  let block3 = createBlock(\`<p><block-child-0/></p>\`);
  
  function value1(ctx, node, key = "") {
    return comp1({}, key + \`\\u00021\`, node, this, null);
  }
  
  return function template(ctx, node, key = "") {
    const ctx1 = ctx;
    const [k_block2, v_block2, l_block2, c_block2] = prepareList([1,2]);
    for (let i1 = 0; i1 < l_block2; i1++) {
      let ctx = Object.create(ctx1);
      ctx["r"] = k_block2[i1];
      const key1 = ctx['r'];
      const skey1 = keyOf(key1);
      const ctx2 = ctx;
      const [k_block4, v_block4, l_block4, c_block4] = prepareList(['a']);
      for (let i2 = 0; i2 < l_block4; i2++) {
        let ctx = Object.create(ctx2);
        ctx["c"] = k_block4[i2];
        const key2 = ctx['c'];
        const skey2 = keyOf(key2);
        ctx["v"] = new LazyValue(value1, ctx, this, node, key + \`\\u00022\\u0002:\${skey1}\\u0002:\${skey2}\`);
        c_block4[i2] = withKey(safeOutput(ctx['v'], node, key, "\\u00023", 2, key1, key2), key2);
      }
      const b4 = list(c_block4);
      c_block2[i1] = withKey(block3([], [b4]), key1);
    }
    const b2 = list(c_block2);
    return block1([], [b2]);
  }
}"
`;

