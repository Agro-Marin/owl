exports[`t-set > slots with an t-set with a component in body 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { LazyValue, createComponent, safeOutput, markRaw } = helpers;
  const comp1 = createComponent(app, \`Child\`, true, false, false, []);
  const comp2 = createComponent(app, \`Blorg\`, true, true, false, []);
  
  let block4 = createBlock(\`<div>coffee</div>\`);
  
  function slot1(ctx, node, key = "") {
    ctx = Object.create(ctx);
    ctx["v"] = new LazyValue(value1, ctx, this, node, key + \`\\u00022\`);
    const b5 = text(\` tea \`);
    const b6 = safeOutput(ctx['v'], node, key, "\\u00023");
    return multi([b5, b6]);
  }
  
  function value1(ctx, node, key = "") {
    const b3 = comp1({}, key + \`\\u00021\`, node, this, null);
    const b4 = block4();
    return multi([b3, b4]);
  }
  
  return function template(ctx, node, key = "") {
    return comp2({slots: markRaw({"default": {__render: slot1, __ctx: ctx, __owner: this}})}, key + \`\\u00024\`, node, this, null);
  }
}"
`;

