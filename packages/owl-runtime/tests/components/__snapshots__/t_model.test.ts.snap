exports[`t-model directive > can also define t-on directive on same event, part 2 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { modelExpr, callHandler } = helpers;
  const hdlr_fn1 = (ctx, ev, model) => model.set(ev.target.value);
  const hdlr_fn2 = (ctx, ev) => callHandler(ctx['this'].onClick, ctx, ev);
  
  let block1 = createBlock(\`<div><input type="radio" id="one" value="One" block-property-0="checked" block-handler-1="click" block-handler-2="click"/><input type="radio" id="two" value="Two" block-property-3="checked" block-handler-4="click" block-handler-5="click"/><input type="radio" id="three" value="Three" block-property-6="checked" block-handler-7="click" block-handler-8="click"/></div>\`);
  
  return function template(ctx, node, key = "") {
    const expr1 = modelExpr(ctx['this'].choice);
    let prop1 = expr1() === "One";
    let hdlr1 = [hdlr_fn1, ctx, 0, expr1];
    let hdlr2 = [hdlr_fn2, ctx];
    const expr2 = modelExpr(ctx['this'].choice);
    let prop2 = expr2() === "Two";
    let hdlr3 = [hdlr_fn1, ctx, 0, expr2];
    let hdlr4 = [hdlr_fn2, ctx];
    const expr3 = modelExpr(ctx['this'].choice);
    let prop3 = expr3() === "Three";
    let hdlr5 = [hdlr_fn1, ctx, 0, expr3];
    let hdlr6 = [hdlr_fn2, ctx];
    return block1([prop1, hdlr1, hdlr2, prop2, hdlr3, hdlr4, prop3, hdlr5, hdlr6]);
  }
}"
`;

