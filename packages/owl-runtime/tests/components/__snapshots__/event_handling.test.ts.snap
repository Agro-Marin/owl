exports[`event handling > objects from scope are properly captured by t-on 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { prepareList, withKey } = helpers;
  const hdlr_fn1 = (ctx,_ev)=>ctx['this'].onClick(ctx['item'].val,_ev);
  
  let block1 = createBlock(\`<div><block-child-0/></div>\`);
  let block3 = createBlock(\`<div class="item" block-handler-0="click"/>\`, [hdlr_fn1]);
  
  return function template(ctx, node, key = "") {
    const ctx1 = ctx;
    const [k_block2, v_block2, l_block2, c_block2] = prepareList(ctx['this'].items);
    for (let i1 = 0; i1 < l_block2; i1++) {
      let ctx = Object.create(ctx1);
      ctx["item"] = k_block2[i1];
      const key1 = ctx['item'];
      c_block2[i1] = withKey(block3([ctx]), key1);
    }
    const b2 = list(c_block2);
    return block1([], [b2]);
  }
}"
`;

exports[`event handling > support for callable expression in event handler 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { safeOutput, callHandler } = helpers;
  const hdlr_fn1 = (ctx, ev) => callHandler(ctx['this'].obj.onInput, ctx, ev);
  
  let block1 = createBlock(\`<div><block-child-0/><input type="text" block-handler-0="input"/></div>\`, [hdlr_fn1]);
  
  return function template(ctx, node, key = "") {
    const b2 = safeOutput(ctx['this'].state.value, node, key, "\\u00021");
    return block1([ctx], [b2]);
  }
}"
`;

exports[`event handling > t-on with handler bound to dynamic argument on a t-foreach 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { prepareList, withKey } = helpers;
  const hdlr_fn1 = (ctx,_ev)=>ctx['this'].onClick(ctx['item'],_ev);
  
  let block1 = createBlock(\`<div><block-child-0/></div>\`);
  let block3 = createBlock(\`<div class="item" block-handler-0="click"/>\`, [hdlr_fn1]);
  
  return function template(ctx, node, key = "") {
    const ctx1 = ctx;
    const [k_block2, v_block2, l_block2, c_block2] = prepareList(ctx['this'].items);
    for (let i1 = 0; i1 < l_block2; i1++) {
      let ctx = Object.create(ctx1);
      ctx["item"] = k_block2[i1];
      const key1 = ctx['item'];
      c_block2[i1] = withKey(block3([ctx]), key1);
    }
    const b2 = list(c_block2);
    return block1([], [b2]);
  }
}"
`;

exports[`event handling > unnamed slot should call the event only once 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { markRaw, createComponent, createCatcher, callHandler } = helpers;
  const comp1 = createComponent(app, \`Child\`, true, true, false, []);
  const hdlr_fn1 = (ctx, ev) => callHandler(ctx['this'].inc, ctx, ev);
  const catcher1 = createCatcher({"click":0}, [hdlr_fn1]);
  
  let block1 = createBlock(\`<div class="named"/>\`);
  let block2 = createBlock(\`<div class="default unnamed"/>\`);
  
  function slot1(ctx, node, key = "") {
    return block1();
  }
  
  function slot2(ctx, node, key = "") {
    return block2();
  }
  
  return function template(ctx, node, key = "") {
    return catcher1(comp1({slots: markRaw({"named": {__render: slot1, __ctx: ctx, __owner: this}, "default": {__render: slot2, __ctx: ctx, __owner: this}})}, key + \`\\u00021\`, node, this, null), ctx);
  }
}"
`;

exports[`event handling > unnamed slot should call the event only once 2`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { callSlot } = helpers;
  
  return function template(ctx, node, key = "") {
    const b2 = callSlot(ctx, node, key + \`\\u00021\`, "named", false, null);
    const b3 = callSlot(ctx, node, key + \`\\u00022\`, "default", false, null);
    return multi([b2, b3]);
  }
}"
`;
