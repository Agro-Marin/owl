exports[`t-component with two classes of the same name > destroying the app while the other class's render is pending destroys both 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { createComponent } = helpers;
  const comp1 = createComponent(app, null, false, false, false, []);
  
  let block1 = createBlock(\`<div><block-child-0/></div>\`);
  
  return function template(ctx, node, key = "") {
    const props1 = {};
    const Comp1 = ctx['this'].state.C;
    const b2 = toggler(Comp1, comp1(props1, key + \`\\u00021\`, node, this, Comp1));
    return block1([], [b2]);
  }
}"
`;

