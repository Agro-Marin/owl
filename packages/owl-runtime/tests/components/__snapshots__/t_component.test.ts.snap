exports[`t-component > can use dynamic components (the class) if given (with different root tagname) 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { keyOf, createComponent } = helpers;
  const comp1 = createComponent(app, null, false, false, false, []);
  
  return function template(ctx, node, key = "") {
    const tKey_1 = keyOf(ctx['this'].state.child);
    const Comp1 = ctx['this'].myComponent;
    return toggler(tKey_1, toggler(Comp1, comp1({}, key + \`\\u0002k\${tKey_1}\\u00021\`, node, this, Comp1)));
  }
}"
`;

