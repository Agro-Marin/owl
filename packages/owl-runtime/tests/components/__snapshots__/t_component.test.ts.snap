exports[`t-component > modifying a sub widget 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { createComponent } = helpers;
  const comp1 = createComponent(app, null, false, false, false, []);
  
  let block1 = createBlock(\`<div><block-child-0/></div>\`);
  
  return function template(ctx, node, key = "") {
    const Comp1 = ctx['this'].Counter;
    const b2 = toggler(Comp1, comp1({}, key + \`\\u00021\`, node, this, Comp1));
    return block1([], [b2]);
  }
}"
`;

exports[`t-component > modifying a sub widget 2`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { safeOutput } = helpers;
  const hdlr_fn1 = (ctx)=>ctx['this'].state.counter++;
  
  let block1 = createBlock(\`<div><block-child-0/><button block-handler-0="click">Inc</button></div>\`, [hdlr_fn1]);
  
  return function template(ctx, node, key = "") {
    const b2 = safeOutput(ctx['this'].state.counter, node, key, "\\u00021");
    return block1([ctx], [b2]);
  }
}"
`;

