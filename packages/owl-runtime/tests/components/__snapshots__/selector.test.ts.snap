// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`rows reading a selector render on a selection change only when their answer changed 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { prepareList, createComponent, withKey, keyOf } = helpers;
  const comp1 = createComponent(app, \`Row\`, true, false, false, ["row","isSelected"]);
  
  let block1 = createBlock(\`<ul><block-child-0/></ul>\`);
  
  return function template(ctx, node, key = "") {
    const ctx1 = ctx;
    const [k_block2, v_block2, l_block2, c_block2] = prepareList(ctx['this'].state.rows);
    for (let i1 = 0; i1 < l_block2; i1++) {
      let ctx = Object.create(ctx1);
      ctx["row"] = k_block2[i1];
      const key1 = ctx['row'].id;
      const skey1 = keyOf(key1);
      c_block2[i1] = withKey(comp1({row: ctx['row'],isSelected: ctx['this'].isSelected}, key + \`\\u00021\\u0002:\${skey1}\`, node, this, null), key1);
    }
    const b2 = list(c_block2);
    return block1([], [b2]);
  }
}"
`;

exports[`rows reading a selector render on a selection change only when their answer changed 2`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { safeOutput } = helpers;
  
  let block1 = createBlock(\`<li block-attribute-0="class"><block-child-0/></li>\`);
  
  return function template(ctx, node, key = "") {
    let attr1 = {on:ctx['this'].props.isSelected(ctx['this'].props.row.id)};
    const b2 = safeOutput(ctx['this'].props.row.label, node, key, "\\u00021");
    return block1([attr1], [b2]);
  }
}"
`;
