exports[`.signal suffix: one signal per child > a .signal in a template and one in a template it calls 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { createComponent, zero, withoutZero, callTemplate } = helpers;
  const comp1 = createComponent(app, \`Leaf\`, true, false, false, [], ["v"]);
  
  let block1 = createBlock(\`<div><block-child-0/><block-child-1/></div>\`);
  
  return function template(ctx, node, key = "") {
    const b2 = comp1({v: 'main'}, key + \`\\u00021\`, node, this, null);
    const b3 = callTemplate(\`sub\`, this, app, ctx[zero] ? withoutZero(ctx) : ctx, node, key + \`\\u00022\`);
    return block1([], [b2, b3]);
  }
}"
`;

