exports[`.signal suffix works in a t-foreach loop 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { prepareList, createComponent, withKey, keyOf } = helpers;
  const comp1 = createComponent(app, \`Item\`, true, false, false, [], ["value"]);
  
  return function template(ctx, node, key = "") {
    const ctx1 = ctx;
    const [k_block1, v_block1, l_block1, c_block1] = prepareList(ctx['this'].state.items);
    for (let i1 = 0; i1 < l_block1; i1++) {
      let ctx = Object.create(ctx1);
      ctx["item"] = k_block1[i1];
      const key1 = ctx['item'].id;
      const skey1 = keyOf(key1);
      c_block1[i1] = withKey(comp1({value: ctx['item'].n}, key + \`\\u00021\\u0002:\${skey1}\`, node, this, null), key1);
    }
    return list(c_block1);
  }
}"
`;

