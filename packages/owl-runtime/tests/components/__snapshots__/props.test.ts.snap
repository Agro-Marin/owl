exports[`.signal suffix: one signal per child > a template with a .signal called twice 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { zero, callTemplate } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/><block-child-1/></div>\`);
  
  return function template(ctx, node, key = "") {
    const ctx1 = Object.create(ctx);
    ctx1["x"] = ctx['this'].state.a;
    ctx1[zero] = null;
    const b2 = callTemplate(\`sub\`, this, app, ctx1, node, key + \`\\u00021\`);
    const ctx2 = Object.create(ctx);
    ctx2["x"] = ctx['this'].state.b;
    ctx2[zero] = null;
    const b3 = callTemplate(\`sub\`, this, app, ctx2, node, key + \`\\u00022\`);
    return block1([], [b2, b3]);
  }
}"
`;

