exports[`.signal suffix: one signal per child > a .signal in slot content and one in the slot host's template 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { createComponent, markRaw } = helpers;
  const comp1 = createComponent(app, \`Leaf\`, true, false, false, [], ["v"]);
  const comp2 = createComponent(app, \`Child\`, true, true, false, []);
  
  function slot1(ctx, node, key = "") {
    return comp1({v: 'slot'}, key + \`\\u00021\`, node, this, null);
  }
  
  return function template(ctx, node, key = "") {
    return comp2({slots: markRaw({"default": {__render: slot1, __ctx: ctx, __owner: this}})}, key + \`\\u00022\`, node, this, null);
  }
}"
`;

