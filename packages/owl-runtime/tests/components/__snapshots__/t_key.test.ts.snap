// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`t-key > a t-key on the t-call node itself recreates it when the key changes 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { keyOf, zero, withoutZero, callTemplate } = helpers;
  
  return function template(ctx, node, key = "") {
    const tKey_1 = keyOf(ctx['this'].state.k);
    return toggler(tKey_1, callTemplate(\`sub\`, this, app, ctx[zero] ? withoutZero(ctx) : ctx, node, key + \`\\u0002k\${tKey_1}\\u00021\`));
  }
}"
`;

exports[`t-key > a t-key on the t-call node itself recreates it when the key changes 2`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { createComponent } = helpers;
  const comp1 = createComponent(app, \`Cell\`, true, false, false, []);
  
  return function template(ctx, node, key = "") {
    return comp1({}, key + \`\\u00021\`, node, this, null);
  }
}"
`;

exports[`t-key > a t-key on the t-call node itself recreates it when the key changes 3`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { safeOutput } = helpers;
  
  let block1 = createBlock(\`<b><block-child-0/></b>\`);
  
  return function template(ctx, node, key = "") {
    const b2 = safeOutput(ctx['this'].id, node, key, "\\u00021");
    return block1([], [b2]);
  }
}"
`;

exports[`t-key > an array t-key is its string form: a new array of the same items keeps the component 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { keyOf, createComponent } = helpers;
  const comp1 = createComponent(app, \`Child\`, true, false, false, ["n"]);
  
  return function template(ctx, node, key = "") {
    const tKey_1 = keyOf([ctx['this'].state.a,'b']);
    return toggler(tKey_1, comp1({n: ctx['this'].state.n}, key + \`\\u0002k\${tKey_1}\\u00021\`, node, this, null));
  }
}"
`;

