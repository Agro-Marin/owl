exports[`t-key > symbol keys are told apart by identity 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { prepareList, createComponent, withKey, keyOf, OwlError } = helpers;
