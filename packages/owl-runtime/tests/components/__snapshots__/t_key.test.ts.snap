exports[`t-key > t-key on multiple Components with t-call 1 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { zero, callTemplate } = helpers;
  
  let block1 = createBlock(\`<span><block-child-0/><block-child-1/></span>\`);
  
  return function template(ctx, node, key = "") {
    const ctx1 = Object.create(ctx);
    ctx1["key"] = ctx['this'].key1;
    ctx1[zero] = null;
    const b2 = callTemplate(\`calledTemplate\`, this, app, ctx1, node, key + \`\\u00021\`);
    const ctx2 = Object.create(ctx);
    ctx2["key"] = ctx['this'].key2;
    ctx2[zero] = null;
    const b3 = callTemplate(\`calledTemplate\`, this, app, ctx2, node, key + \`\\u00022\`);
    return block1([], [b2, b3]);
  }
}"
`;

