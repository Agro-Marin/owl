exports[`a child re-rendered because its parent's pass was cancelled runs onWillUpdateProps once per new props 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { createComponent, safeOutput } = helpers;
  const comp1 = createComponent(app, \`Fast\`, true, false, false, ["value"]);
  const comp2 = createComponent(app, \`Slow\`, true, false, false, ["value"]);
  
  let block1 = createBlock(\`<div><block-child-0/><block-child-1/><i><block-child-2/></i></div>\`);
  
  return function template(ctx, node, key = "") {
    const b2 = comp1({value: ctx['this'].state.value}, key + \`\\u00021\`, node, this, null);
    const b3 = comp2({value: ctx['this'].state.value}, key + \`\\u00022\`, node, this, null);
    const b4 = safeOutput(ctx['this'].state.other, node, key, "\\u00023");
    return block1([], [b2, b3, b4]);
  }
}"
`;

