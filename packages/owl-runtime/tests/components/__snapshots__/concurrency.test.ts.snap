// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Cascading renders after microtaskTick 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { createComponent, prepareList, safeOutput, withKey } = helpers;
  const comp1 = createComponent(app, \`Child\`, true, false, false, []);
  
  return function template(ctx, node, key = "") {
    const b2 = comp1({}, key + \`\\u00021\`, node, this, null);
    const b3 = text(\` _ \`);
    const ctx1 = ctx;
    const [k_block4, v_block4, l_block4, c_block4] = prepareList(ctx['this'].state);
    for (let i1 = 0; i1 < l_block4; i1++) {
      let ctx = Object.create(ctx1);
      ctx["elem"] = k_block4[i1];
      const key1 = ctx['elem'].id;
      c_block4[i1] = withKey(safeOutput(ctx['elem'].id, node, key, "\\u00022", 1, key1), key1);
    }
    const b4 = list(c_block4);
    return multi([b2, b3, b4]);
  }
}"
`;

exports[`Cascading renders after microtaskTick 2`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { prepareList, createComponent, withKey, keyOf } = helpers;
  const comp1 = createComponent(app, \`Element\`, true, false, false, ["id"]);
  
  return function template(ctx, node, key = "") {
    const ctx1 = ctx;
    const [k_block1, v_block1, l_block1, c_block1] = prepareList(ctx['this'].state);
    for (let i1 = 0; i1 < l_block1; i1++) {
      let ctx = Object.create(ctx1);
      ctx["elem"] = k_block1[i1];
      const key1 = ctx['elem'].id;
      const skey1 = keyOf(key1);
      c_block1[i1] = withKey(comp1({id: ctx['elem'].id}, key + \`\\u00021\\u0002:\${skey1}\`, node, this, null), key1);
    }
    return list(c_block1);
  }
}"
`;

