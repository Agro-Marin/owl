exports[`two renderings initiated between willPatch and patched 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { keyOf, createComponent } = helpers;
  const comp1 = createComponent(app, \`Panel\`, true, false, false, ["val"]);
  
  let block1 = createBlock(\`<div><block-child-0/></div>\`);
  
  return function template(ctx, node, key = "") {
    let b2;
    if (ctx['this'].state.flag) {
      const tKey_1 = keyOf('panel_'+ctx['this'].state.panel);
      b2 = toggler(tKey_1, comp1({val: ctx['this'].state.panel}, key + \`\\u0002k\${tKey_1}\\u00021\`, node, this, null));
    }
    return block1([], [b2]);
  }
}"
`;

