exports[`t-foreach with dynamic async component 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { prepareList, createComponent, withKey, keyOf } = helpers;
  const comp1 = createComponent(app, null, false, false, false, ["key"]);
  
  return function template(ctx, node, key = "") {
    const ctx1 = ctx;
    const [k_block1, v_block1, l_block1, c_block1] = prepareList(ctx['this'].list);
    for (let i1 = 0; i1 < l_block1; i1++) {
      let ctx = Object.create(ctx1);
      ctx["arr"] = k_block1[i1];
      ctx["arr_index"] = i1;
      const key1 = ctx['arr_index'];
      const skey1 = keyOf(key1);
      let b3;
      if (ctx['arr']) {
        const Comp1 = ctx['this'].myComp;
        b3 = toggler(Comp1, comp1({key: ctx['arr'][0]}, key + \`\\u00021\\u0002:\${skey1}\`, node, this, Comp1));
      }
      c_block1[i1] = withKey(multi([b3]), key1);
    }
    return list(c_block1);
  }
}"
`;

