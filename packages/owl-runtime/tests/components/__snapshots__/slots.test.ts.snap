exports[`slots > t-slot in recursive templates 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { safeOutput, prepareList, zero, callTemplate, withKey, keyOf, createComponent } = helpers;
  const comp1 = createComponent(app, \`Wrapper\`, true, true, false, []);
  
  function slot1(ctx, node, key = "") {
    const b2 = safeOutput(ctx['name']||ctx['this'].name, node, key, "\\u00021");
    const ctx1 = ctx;
    const [k_block3, v_block3, l_block3, c_block3] = prepareList(ctx['items']||ctx['this'].items);
    for (let i1 = 0; i1 < l_block3; i1++) {
      let ctx = Object.create(ctx1);
      ctx["item"] = k_block3[i1];
      ctx["item_first"] = i1 === 0;
      ctx["item_last"] = i1 === k_block3.length - 1;
      ctx["item_index"] = i1;
      ctx["item_value"] = v_block3[i1];
      const key1 = ctx['item'].name;
      const skey1 = keyOf(key1);
      let b5, b6;
      if (!ctx['item'].children.length) {
        b5 = safeOutput(ctx['item'].name, node, key, "\\u00022", 1, key1);
      } else {
        const ctx2 = Object.create(ctx1); ctx2["item"] = ctx["item"]; ctx2["item_first"] = ctx["item_first"]; ctx2["item_last"] = ctx["item_last"]; ctx2["item_index"] = ctx["item_index"]; ctx2["item_value"] = ctx["item_value"];
        ctx2["name"] = ctx['item'].name;
        ctx2["items"] = ctx['item'].children;
        ctx2[zero] = null;
        b6 = callTemplate(\`_test_recursive_template\`, this, app, ctx2, node, key + \`\\u00023\\u0002:\${skey1}\`);
      }
      c_block3[i1] = withKey(multi([b5, b6]), key1);
    }
    const b3 = list(c_block3);
    return multi([b2, b3]);
  }
  
  return function template(ctx, node, key = "") {
    return comp1({slots: {"default": {__render: slot1, __ctx: ctx, __owner: this}}}, key + \`\\u00024\`, node, this, null);
  }
}"
`;

