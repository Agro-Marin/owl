exports[`slots > a slot called in a loop and again after it gives each call its own components 2`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { prepareList, callSlot, withKey, keyOf, safeOutput } = helpers;
  
  let block4 = createBlock(\`<i><block-child-0/></i>\`);
  
  return function template(ctx, node, key = "") {
    const ctx1 = ctx;
    const [k_block2, v_block2, l_block2, c_block2] = prepareList([1,2]);
    for (let i1 = 0; i1 < l_block2; i1++) {
      let ctx = Object.create(ctx1);
      ctx["i"] = k_block2[i1];
      const key1 = ctx['i'];
      const skey1 = keyOf(key1);
      c_block2[i1] = withKey(callSlot(ctx, node, key + \`\\u00021\\u0002:\${skey1}\`, "default", false, null), key1);
    }
    const b2 = list(c_block2);
    const b5 = safeOutput('|', node, key, "\\u00022");
    const b4 = block4([], [b5]);
    const b6 = callSlot(ctx, node, key + \`\\u00023\`, "default", false, null);
    return multi([b2, b4, b6]);
  }
}"
`;

