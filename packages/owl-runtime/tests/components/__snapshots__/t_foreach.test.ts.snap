        ctx["blip_index"] = i2;
        const key2 = ctx['blip_index'];
        const skey2 = keyOf(key2);
        c_block3[i2] = withKey(comp1({blip: ctx['blip']}, key + \`__1__\${skey1}__\${skey2}\`, node, this, null), key2);
      }
      c_block2[i1] = withKey(list(c_block3), key1);
    }
    const b2 = list(c_block2);
