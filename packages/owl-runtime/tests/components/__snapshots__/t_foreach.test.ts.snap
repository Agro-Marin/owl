      ctx["item"] = k_block2[i1];
      const key1 = 'li_'+ctx['item'];
      const skey1 = keyOf(key1);
      const b4 = comp1({item: ctx['item']}, key + \`__1__\${skey1}\`, node, this, null);
      c_block2[i1] = withKey(block3([], [b4]), key1);
