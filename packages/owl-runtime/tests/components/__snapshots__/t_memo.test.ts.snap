      ctx["group"] = k_block4[i1];
      const key1 = ctx['group'].id;
      const skey1 = keyOf(key1);
      const memo1_site = key + \`\\u00022\\u0002:\${skey1}\`;
      const memo1_previous = memoPrevious(node, memo1_site);
      const memo1_next = new Map();
