  let block5 = createBlock(\`<div><ul><block-child-0/></ul></div>\`);
  let block7 = createBlock(\`<li><block-child-0/>:<block-child-1/></li>\`);
  
  return function template(ctx, node, key = "") {
    const b3 = safeOutput(ctx['this'].state.title, node, key, "\\u00021");
    const b2 = block2([], [b3]);
