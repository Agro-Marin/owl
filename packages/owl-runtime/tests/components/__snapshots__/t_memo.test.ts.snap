    const b4 = callTemplate(\`__template__999\`, this, app, Object.assign(Object.create(ctx), {rows: ctx['this'].state.left, side: 'left', [zero]: null}), node, key + \`__2\`);
    const b5 = callTemplate(\`__template__999\`, this, app, Object.assign(Object.create(ctx), {rows: ctx['this'].state.right, side: 'right', [zero]: null}), node, key + \`__3\`);
    return multi([b2, b4, b5]);
  }
}"
`;

