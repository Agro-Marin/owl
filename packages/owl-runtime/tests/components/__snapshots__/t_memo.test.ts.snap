exports[`t-memo > a list the previous render did not show starts without memos 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { memoPrevious, memoKeep, memoHit, prepareList, safeOutput, withKey } = helpers;
  
  let block2 = createBlock(\`<ul><block-child-0/></ul>\`);
  let block4 = createBlock(\`<li><block-child-0/></li>\`);
  
  return function template(ctx, node, key = "") {
    let b2;
    if (ctx['this'].state.shown) {
      const memo1_site = key + \`__1\`;
      const memo1_previous = memoPrevious(node, memo1_site);
      const memo1_next = new Map();
      const ctx1 = ctx;
      const [k_block3, v_block3, l_block3, c_block3] = prepareList(ctx['this'].state.rows);
      for (let i1 = 0; i1 < l_block3; i1++) {
        let ctx = Object.create(ctx1);
        ctx["row"] = k_block3[i1];
        const key1 = ctx['row'].id;
        const deps1 = [];
        const hit1 = memoHit(memo1_previous, key1, deps1);
        if (hit1 !== undefined) {
          c_block3[i1] = hit1.vnodes[hit1.index];
          memo1_next.set(key1, { deps: deps1, vnodes: c_block3, index: i1 });
          continue;
        }
        const b5 = safeOutput(ctx['row'].label, key, "__2", 1, key1);
        c_block3[i1] = withKey(block4([], [b5]), key1);
        memo1_next.set(key1, { deps: deps1, vnodes: c_block3, index: i1 });
      }
      memoKeep(node, memo1_site, memo1_next);
      const b3 = list(c_block3);
      b2 = block2([], [b3]);
    }
    return multi([b2]);
  }
}"
`;

