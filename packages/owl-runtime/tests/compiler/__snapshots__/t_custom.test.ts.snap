// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`t-custom > can use t-custom directive on a node 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { callHandler } = helpers;
  const hdlr_fn1 = (ctx, ev) => callHandler(ctx['this'].click, ctx, ev);
  
  const block1_handlers = [hdlr_fn1];
  let block1 = createBlock(\`<div class="my-div" block-handler-0="click"/>\`, block1_handlers);
  
  return function template(ctx, node, key = "") {
    return block1([ctx], null, block1_handlers);
  }
}"
`;

exports[`t-custom > can use t-custom directive with modifiers on a node 1`] = `
