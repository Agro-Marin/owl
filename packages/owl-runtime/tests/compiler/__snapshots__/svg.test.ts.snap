// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`properly support svg > a prefixed attribute in a block of its own keeps its namespace 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  
  let block1 = createBlock(\`<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"><block-child-0 xmlns=""/></svg>\`);
  let block2 = createBlock(\`<use xmlns="http://www.w3.org/2000/svg" xmlns:ns1="http://www.w3.org/1999/xlink" ns1:href="#a"/>\`);
  
  return function template(ctx, node, key = "") {
    let b2;
    if (ctx['c']) {
      b2 = block2();
    }
    return block1([], [b2]);
  }
}"
`;

exports[`properly support svg > a prefixed t-att name is set and removed in its namespace 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { attrsValue } = helpers;
  
  let block1 = createBlock(\`<svg xmlns="http://www.w3.org/2000/svg"><use block-attributes="0"/></svg>\`);
  
  return function template(ctx, node, key = "") {
    let attr1 = attrsValue({'xlink:href':ctx['href']});
    return block1([attr1]);
  }
}"
`;

exports[`properly support svg > add proper namespace to g tags 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  
  let block1 = createBlock(\`<g xmlns="http://www.w3.org/2000/svg"><circle cx="50" cy="50" r="4" stroke="green" stroke-width="1" fill="yellow"/> </g>\`);
  
  return function template(ctx, node, key = "") {
    return block1();
  }
}"
`;

