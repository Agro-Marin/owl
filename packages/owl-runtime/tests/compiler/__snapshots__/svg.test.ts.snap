exports[`properly support svg > an element given the xhtml namespace in an svg is an html element 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  
  let block1 = createBlock(\`<svg xmlns="http://www.w3.org/2000/svg"><foreignObject><block-child-0 xmlns=""/></foreignObject></svg>\`);
  let block2 = createBlock(\`<div xmlns="http://www.w3.org/1999/xhtml"><p>x</p></div>\`);
  
  return function template(ctx, node, key = "") {
    const b2 = block2();
    return block1([], [b2]);
  }
}"
`;

