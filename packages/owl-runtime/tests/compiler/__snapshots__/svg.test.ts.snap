exports[`properly support svg > svg namespace added to sub templates if root tag is path 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { zero, withoutZero, callTemplate } = helpers;
  
  let block1 = createBlock(\`<svg xmlns="http://www.w3.org/2000/svg"><block-child-0 xmlns=""/></svg>\`);
  
  return function template(ctx, node, key = "") {
    const b2 = callTemplate(\`path\`, this, app, ctx[zero] ? withoutZero(ctx) : ctx, node, key + \`\\u00021\`);
    return block1([], [b2]);
  }
}"
`;

