  }
}"
`;

exports[`t-key > t-key directive in a list 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { prepareList, safeOutput, withKey, keyOf } = helpers;
  
  let block1 = createBlock(\`<ul><block-child-0/></ul>\`);
  let block3 = createBlock(\`<li><block-child-0/></li>\`);
  
  return function template(ctx, node, key = "") {
    const ctx1 = ctx;
    const [k_block2, v_block2, l_block2, c_block2] = prepareList(ctx['beers']);
    for (let i1 = 0; i1 < l_block2; i1++) {
      let ctx = Object.create(ctx1);
      ctx[\`beer\`] = k_block2[i1];
      const key1 = ctx['beer'].id;
      const skey1 = keyOf(key1);
      const b4 = safeOutput(ctx['beer'].name, key + \`__1__\${skey1}\`);
      c_block2[i1] = withKey(block3([], [b4]), key1);
    }
    const b2 = list(c_block2);
    return block1([], [b2]);
  }
}"
`;

exports[`t-key > t-key on a t inside a node keeps its content 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { keyOf } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/></div>\`);
  
  return function template(ctx, node, key = "") {
    const tKey_1 = keyOf(ctx['k']);
    const b2 = toggler(tKey_1, text(\`hello\`));
    return block1([], [b2]);
  }
}"
`;

exports[`t-key > t-key on a t inside a node keeps its content 2`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { keyOf } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/></div>\`);
  
  return function template(ctx, node, key = "") {
    let b2;
    const tKey_1 = keyOf(ctx['k']);
    let b3;
    if (ctx['c']) {
      b3 = text(\`yes\`);
    }
    b2 = toggler(tKey_1, multi([b3]));
    return block1([], [b2]);
  }
}"
`;

exports[`t-key > t-key on a t inside a node keeps its content 3`] = `
"function anonymous(app, bdom, helpers
