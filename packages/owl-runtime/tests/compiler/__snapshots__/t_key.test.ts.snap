    return block1([], [b2]);
  }
}"
`;

exports[`t-key > t-key on sub dom node pushes a child block in its parent 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { keyOf } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/><block-child-1/></div>\`);
  let block2 = createBlock(\`<span/>\`);
  let block3 = createBlock(\`<div><h1/></div>\`);
  
  return function template(ctx, node, key = "") {
    let b2, b3;
    if (ctx['hasSpan']) {
      b2 = block2();
    }
    const tKey_1 = keyOf(ctx['key']);
    b3 = toggler(tKey_1, block3());
    return block1([], [b2, b3]);
  }
}"
`;

