// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`t-key > can use t-key directive on a node 1`] = `
"function anonymous(app, bdom, helpers
) {
  let { text, createBlock, list, multi, html, toggler } = bdom;
  let { keyOf, safeOutput } = helpers;
  
  let block1 = createBlock(\`<div><block-child-0/></div>\`);
  
  return function template(ctx, node, key = "") {
    const tKey_1 = keyOf(ctx['beer'].id);
    const b2 = toggler(tKey_1, safeOutput(ctx['beer'].name, tKey_1 + key + \`__1\`));
    return toggler(tKey_1, block1([], [b2]));
  }
}"
`;

