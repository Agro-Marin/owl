      for (let i2 = 0; i2 < l_block6; i2++) {
        let ctx = Object.create(ctx2);
        ctx["b"] = k_block6[i2];
        const key2 = ctx['b'];
        c_block6[i2] = withKey(safeOutput(ctx['v'], node, key, "\\u00024", 2, key1, key2), key2);
      }
      const b6 = list(c_block6);
      const ctx3 = ctx;
